# Your Edpire API key. Server-side only, never in the Angular app.
# Get it from edpire.com -> Integrations -> API keys.
# Scopes needed: read:assessments, write:submissions, read:results
EDPIRE_API_KEY=edp_live_xxxxxxxxxxxxxxxxxxxxx

# Override only if you run a self-hosted or staging Edpire.
# EDPIRE_BASE_URL=https://edpire.com

# PORT=8787
